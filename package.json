{
  "name": "mongoose-slugger-plugin",
  "description": "Mongoose plugin to automatically generate so called slugs (atomically)",
  "author": "Philipp Katz <philipp@philippkatz.de>",
  "version": "6.1.1",
  "main": "dist/slugger.js",
  "types": "dist/slugger.d.ts",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/qqilihq/mongoose-slugger/issues"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/qqilihq/mongoose-slugger.git"
  },
  "keywords": [
    "mongoose",
    "mongodb",
    "slug",
    "typescript",
    "mongoose-plugin"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "pnpm run lint:eslint && pnpm run lint:types && pnpm run lint:knip",
    "lint:eslint": "eslint",
    "lint:knip": "knip",
    "lint:types": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"['./coverage', './dist'].forEach(entry => require('fs').rmSync(entry, { recursive: true, force: true }));\"",
    "preversion": "pnpm run clean && pnpm run lint && pnpm test && pnpm run build",
    "release": "pnpm version --message \"chore: release %s\"",
    "prepare": "husky"
  },
  "dependencies": {
    "limax": "^4.2.3",
    "semver": "^7.7.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22",
    "@types/semver": "^7.7.1",
    "@vitest/coverage-v8": "^4.1.2",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^10.1.0",
    "eslint-plugin-n": "^18.3.0",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "knip": "^6.34.0",
    "lint-staged": "^17.4.1",
    "mongodb-memory-server-global": "^11.0.1",
    "mongoose": "^9.0.0",
    "prettier": "^3.8.1",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.0",
    "vitest": "^4.1.2"
  },
  "peerDependencies": {
    "mongoose": "^7.0.0 || ^8.0.0 || ^9.0.0"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.20.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.25.0",
  "config": {
    "mongodbMemoryServer": {
      "version": "8.2.6"
    }
  }
}
